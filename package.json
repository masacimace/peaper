{
  "name": "@peaper/local",
  "version": "0.4.0-knowledge.1",
  "private": true,
  "description": "Your local coding workspace. Peaper Skills and Memory preview.",
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "bin": {
    "peaper": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/cli.js",
    "doctor": "node dist/cli.js doctor",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test tests/*.test.ts apps/web/tests/*.test.tsx",
    "test:package": "node scripts/test-package.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.71",
    "@fastify/static": "10.1.6",
    "@fastify/websocket": "11.3.4",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.143",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "node-pty": "1.1.0",
    "open": "11.0.4",
    "picocolors": "1.1.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.5",
    "@types/ws": "8.18.2",
    "esbuild": "0.28.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "ws": "8.22.0"
  }
}
